{
  "name": "playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Learn to Code — a Swift Playgrounds-style interactive tutorial app for Python and Web (HTML/CSS/JS).",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:offline": "node scripts/offline.mjs",
    "a11y": "node scripts/a11y.mjs",
    "verify:remote": "tsx scripts/verify-remote.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "pyodide": "^0.26.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.12.0",
    "playwright": "^1.60.0",
    "sharp": "^0.33.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
